% ---------------------------------------------------------------------

% *** MUST ADDRESS, NOT MERELY CITE ***
% ISMM 2026. A stride-based Markov prefetcher for GPU unified memory,
% prototyped as a NON-INVASIVE RUNTIME LAYER on real workloads, reporting up
% to 88% prediction accuracy and up to 1.48x speedup.
%
% This is the nearest thing in the literature to a positive result for the
% family our C2 stride policy sits in, and our C2 result is that stride
% speculation actively HARMS (+8.2% T4, +3.71% 5070 Ti). A reviewer who knows
% this paper will read our stride result as contradicted unless we distinguish
% the two explicitly. The distinction we can defend from our own data:
%   (a) they predict to drive migration ABOVE the driver; we speculate INSIDE
%       the fault handler, off-path, paying a per-fault dispatch cost they
%       never incur;
%   (b) our negative result is not about prediction accuracy at all -- our
%       oracle is 100% accurate by construction and still yields nothing.
% Their accuracy figure and our null are therefore compatible, and saying so
% converts an apparent contradiction into support for our central claim.
@inproceedings{shen2026stride,
  author    = {Shen, Yunqi and Nikolopoulos, Dimitrios},
  title     = {Stride-Aware Page Prefetching for {GPU} Unified Memory via {Markov} Pattern Prediction},
  booktitle = {Proceedings of the 2026 ACM SIGPLAN International Symposium on Memory Management (ISMM '26)},
  address   = {Boulder, CO, USA},
  year      = {2026},
  pages     = {52--65},
  publisher = {ACM},
  doi       = {10.1145/3814942.3816131},
  note      = {User-space LD\_PRELOAD layer over CUPTI; cudaMemAdvise + cudaMemPrefetchAsync; A100 and V100.}
}


