@article{wang2025rmax,
  title   = {{R-Max}: A Method for Approximating the Benefit of Ideal
             Prefetching and Replacement Policy},
  author  = {Wang, Lei and others},
  journal = {IEEE Computer Architecture Letters},
  year    = {2025},
  note    = {UNVERIFIED: full author list, volume/pages. Approximates ideal
             prefetching under realistic bandwidth and capacity constraints but
             oracular knowledge of future accesses, to bound remaining gain.
             Direct methodological precedent for our oracle policy. They report
             headroom up to 299.6% in CPU caches; we find 0.08--7.94% in the
             UVM fault path -- worth a sentence, since it shows the bound is
             subsystem-specific, not a property of the method.}
}


